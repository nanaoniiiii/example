<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/padding_screen">

        <!-- ============ 视觉AI测试区 ============ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textColor="?attr/colorOnSurface"
            android:text="@string/lab_vision_title" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="@dimen/card_elevation">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/padding_card">

                <!-- 拍照识别按钮 -->
                <Button
                    android:id="@+id/btnCapture"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:text="@string/lab_vision_capture"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    app:icon="@drawable/ic_photo_camera"
                    app:iconGravity="textStart"
                    style="@style/Widget.Material3.Button.TonalButton" />

                <!-- 结果展示 -->
                <TextView
                    android:id="@+id/tvVisionResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="?attr/colorOnSurface"
                    android:minHeight="48dp"
                    android:gravity="center_vertical"
                    android:visibility="gone"
                    tools:visibility="visible"
                    tools:text="前方有一张桌子，上面放着一个水杯和一台笔记本电脑" />

                <LinearLayout
                    android:id="@+id/layoutVisionMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/tvConfidence"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="置信度: 92%" />

                    <TextView
                        android:id="@+id/tvVisionTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="耗时: 345ms" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- 视觉历史记录 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="?attr/colorOnSurface"
            android:text="@string/lab_vision_history" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvVisionHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:nestedScrollingEnabled="false"
            tools:listitem="@layout/item_vision_history" />

        <TextView
            android:id="@+id/tvVisionEmpty"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:text="@string/lab_vision_empty" />

        <!-- ============ 语音AI测试区 ============ -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:background="@color/outline" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textColor="?attr/colorOnSurface"
            android:text="@string/lab_voice_title" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="@dimen/card_elevation">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="@dimen/padding_card">

                <!-- 麦克风按钮 -->
                <FrameLayout
                    android:id="@+id/frameMic"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/circle_mic_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <ImageView
                        android:id="@+id/ivMicIcon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_mic"
                        android:contentDescription="麦克风" />

                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:text="@string/lab_voice_placeholder" />

                <!-- 波形动画区域 -->
                <com.aiguide.assistant.ui.WaveformView
                    android:id="@+id/viewWaveform"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_marginTop="12dp"
                    android:background="@color/surface_variant"
                    android:visibility="invisible" />

                <!-- ASR 识别结果 -->
                <TextView
                    android:id="@+id/tvVoiceResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="?attr/colorOnSurface"
                    android:minHeight="48dp"
                    android:gravity="center"
                    android:text="@string/onboarding_page4_placeholder" />

                <!-- 播放TTS按钮 -->
                <Button
                    android:id="@+id/btnPlayTts"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/btn_min_touch"
                    android:layout_marginTop="8dp"
                    android:text="@string/lab_voice_play_result"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:enabled="false" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>
